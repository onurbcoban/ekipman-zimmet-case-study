<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Mühendis Kayıt Kuralı -->
        <record id="rule_zimmet_muhendis" model="ir.rule">
            <field name="name">Mühendis Kendi Kayıtları</field>
            <field name="model_id" ref="model_ekipman_zimmet"/>
            <field name="domain_force">[('calisan_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_zimmet_muhendis'))]"/>
        </record>

        <!-- Yetkili Kayıt Kuralı -->
        <record id="rule_zimmet_yetkili" model="ir.rule">
            <field name="name">Yetkili Tüm Kayıtlar</field>
            <field name="model_id" ref="model_ekipman_zimmet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_zimmet_yetkili'))]"/>
        </record>
    </data>
</odoo>
