<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Kategori -->
        <record id="module_category_ekipman_zimmet" model="ir.module.category">
            <field name="name">Ekipman Zimmet</field>
            <field name="sequence">10</field>
        </record>

        <!-- Mühendis Grubu -->
        <record id="group_zimmet_muhendis" model="res.groups">
            <field name="name">Mühendis</field>
            <field name="category_id" ref="module_category_ekipman_zimmet"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Yetkili Grubu -->
        <record id="group_zimmet_yetkili" model="res.groups">
            <field name="name">Yetkili</field>
            <field name="category_id" ref="module_category_ekipman_zimmet"/>
            <field name="implied_ids" eval="[(4, ref('group_zimmet_muhendis'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
