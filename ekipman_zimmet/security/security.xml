<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Kategori -->
        <record id="module_category_ekipman_zimmet" model="ir.module.category">
            <field name="name">Ekipman Zimmet</field>
            <field name="sequence">10</field>
        </record>

        <!-- Mühendis Grubu -->
        <record id="group_muhendis" model="res.groups">
            <field name="name">Mühendis / Talep Eden</field>
            <field name="category_id" ref="module_category_ekipman_zimmet"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Yetkili Grubu -->
        <record id="group_yetkili" model="res.groups">
            <field name="name">Yetkili</field>
            <field name="category_id" ref="module_category_ekipman_zimmet"/>
            <field name="implied_ids" eval="[(4, ref('group_muhendis'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
        </record>
    </data>
    <data noupdate="1">
        <!-- Mühendis Kayıt Kuralı -->
        <record id="rule_zimmet_muhendis" model="ir.rule">
            <field name="name">Mühendis Kendi Kayıtları</field>
            <field name="model_id" ref="model_ekipman_zimmet"/>
            <field name="domain_force">[('calisan_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_muhendis'))]"/>
        </record>

        <!-- Yetkili Kayıt Kuralı -->
        <record id="rule_zimmet_yetkili" model="ir.rule">
            <field name="name">Yetkili Tüm Kayıtlar</field>
            <field name="model_id" ref="model_ekipman_zimmet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_yetkili'))]"/>
        </record>
    </data>
</odoo>
