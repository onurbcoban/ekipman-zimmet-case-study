<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ekipman_kategori_list" model="ir.ui.view">
        <field name="name">ekipman.kategori.list</field>
        <field name="model">ekipman.kategori</field>
        <field name="arch" type="xml">
            <list string="Kategoriler">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_ekipman_kategori_form" model="ir.ui.view">
        <field name="name">ekipman.kategori.form</field>
        <field name="model">ekipman.kategori</field>
        <field name="arch" type="xml">
            <form string="Kategori">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ekipman_kategori" model="ir.actions.act_window">
        <field name="name">Kategoriler</field>
        <field name="res_model">ekipman.kategori</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Yeni bir ekipman kategorisi ekleyin.
            </p>
        </field>
    </record>
</odoo>
