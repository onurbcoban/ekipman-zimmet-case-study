    <menuitem id="menu_ekipman_zimmet_root"
              name="Ekipman Zimmet"
              sequence="10"/>

    <!-- Alt Menüler -->
    <menuitem id="menu_ekipman_zimmet_talep"
              name="Zimmet Talepleri"
              parent="menu_ekipman_zimmet_root"
              action="action_ekipman_zimmet"
              sequence="10"/>

    <!-- Kuyruk Action'ları -->
    <record id="action_ekipman_zimmet_onay_bekleyenler" model="ir.actions.act_window">
        <field name="name">Onay Bekleyenler</field>
        <field name="res_model">ekipman.zimmet</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_ekipman_zimmet_list_kuyruk"/>
        <field name="context">{'search_default_onay_bekleyenler': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Onay bekleyen zimmet talebi bulunmamaktadır.
            </p>
        </field>
    </record>

    <record id="action_ekipman_zimmet_teslim_bekleyenler" model="ir.actions.act_window">
        <field name="name">Teslim Bekleyenler</field>
        <field name="res_model">ekipman.zimmet</field>
