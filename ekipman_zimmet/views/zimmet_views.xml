<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ekipman_zimmet_list" model="ir.ui.view">
        <field name="name">ekipman.zimmet.list</field>
        <field name="model">ekipman.zimmet</field>
        <field name="arch" type="xml">
            <list string="Zimmet Talepleri"
                  decoration-danger="state == 'teslim_edildi' and planlanan_bitis &lt; context_today().strftime('%Y-%m-%d')"
                  decoration-warning="state == 'onaylandi' and planlanan_bitis &lt; current_date"
                  decoration-info="state == 'talep_edildi'"
                  decoration-muted="state in ('iade_edildi', 'kayip', 'reddedildi', 'iptal')">
                <field name="name"/>
                <field name="cihaz_id"/>
                <field name="calisan_id"/>
                <field name="cihaz_kullanilabilirlik" optional="hide" widget="badge" decoration-success="cihaz_kullanilabilirlik == 'kullanilabilir'" decoration-warning="cihaz_kullanilabilirlik in ('kontrolde', 'bakimda')" decoration-danger="cihaz_kullanilabilirlik in ('kayip', 'hurda')"/>
                <field name="planlanan_baslangic"/>
                <field name="planlanan_bitis"/>
                <field name="fiili_baslangic" optional="hide"/>
                <field name="fiili_bitis" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('taslak', 'talep_edildi')"
                       decoration-warning="state == 'onaylandi'"
                       decoration-success="state == 'teslim_edildi'"
                       decoration-muted="state in ('iade_edildi', 'kayip', 'reddedildi', 'iptal')"/>
            </list>
        </field>
    </record>

    <!-- Kuyruklarda yetkili, cihazın şu an verilebilir olup olmadığını listede görür (A7, F3). -->
    <record id="view_ekipman_zimmet_list_kuyruk" model="ir.ui.view">
        <field name="name">ekipman.zimmet.list.kuyruk</field>
        <field name="model">ekipman.zimmet</field>
        <field name="inherit_id" ref="view_ekipman_zimmet_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="cihaz_kullanilabilirlik" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>

    <record id="view_ekipman_zimmet_form" model="ir.ui.view">
        <field name="name">ekipman.zimmet.form</field>
        <field name="model">ekipman.zimmet</field>
        <field name="arch" type="xml">
            <form string="Zimmet">
                <header>
                    <field name="talep_sahibi_mi" invisible="1"/>
                    <button name="action_gonder" string="Talep Et" type="object" class="oe_highlight" invisible="state != 'taslak' or not talep_sahibi_mi"/>
                    <button name="action_geri_cek" string="Geri Çek" type="object" invisible="state != 'talep_edildi' or not talep_sahibi_mi"/>
                    <button name="action_onayla" string="Onayla" type="object" class="oe_highlight" invisible="state != 'talep_edildi'" groups="ekipman_zimmet.group_zimmet_yetkili"/>
                    <button name="action_reddet" string="Reddet" type="object" invisible="state != 'talep_edildi'" groups="ekipman_zimmet.group_zimmet_yetkili"/>
                    <button name="action_teslim_et" string="Teslim Et" type="object" class="oe_highlight" invisible="state != 'onaylandi'" groups="ekipman_zimmet.group_zimmet_yetkili"/>
                    <button name="action_iade_al" string="İade Al" type="object" class="oe_highlight" invisible="state != 'teslim_edildi'" groups="ekipman_zimmet.group_zimmet_yetkili"/>
                    <button name="action_kayip" string="Kayıp Olarak İşaretle" type="object" invisible="state != 'teslim_edildi'" groups="ekipman_zimmet.group_zimmet_yetkili" confirm="Kayıt kayıp olarak kapatılacak ve cihaz kayıp durumuna geçecek. Emin misiniz?"/>
                    <button name="action_iptal" string="İptal Et" type="object" invisible="state not in ('talep_edildi', 'onaylandi')"/>
                    <button name="action_taslagi_sil" string="Taslağı Sil" type="object" invisible="state != 'taslak' or not talep_sahibi_mi" confirm="Bu taslak kalıcı olarak silinecek. Emin misiniz?"/>
                    <button name="action_uzatmayi_onayla" string="Uzatmayı Onayla" type="object" class="oe_highlight" invisible="not istenen_bitis" groups="ekipman_zimmet.group_zimmet_yetkili"/>
                    <button name="action_uzatmayi_reddet" string="Uzatmayı Reddet" type="object" invisible="not istenen_bitis" groups="ekipman_zimmet.group_zimmet_yetkili"/>
                    <button name="action_uzatmayi_geri_cek" string="Uzatmayı Geri Çek" type="object" invisible="not istenen_bitis or not talep_sahibi_mi"/>
                    <field name="state" widget="statusbar" statusbar_visible="taslak,talep_edildi,onaylandi,teslim_edildi,iade_edildi"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not cihaz_uyarisi">
                        <field name="cihaz_uyarisi"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not istenen_bitis">
                        Uzatma isteği yetkili onayını bekliyor.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Talep Bilgileri">
                            <field name="cihaz_id" readonly="state != 'taslak'"/>
                            <field name="cihaz_aciklama" invisible="not cihaz_aciklama"/>
                            <field name="cihaz_kullanilabilirlik" invisible="not cihaz_id" widget="badge" decoration-success="cihaz_kullanilabilirlik == 'kullanilabilir'" decoration-warning="cihaz_kullanilabilirlik in ('kontrolde', 'bakimda')" decoration-danger="cihaz_kullanilabilirlik in ('kayip', 'hurda')"/>
                            <field name="dolu_tarihler" invisible="state != 'taslak'"/>
                            <field name="calisan_id" readonly="1"/>
                            <field name="toplu_ref" invisible="not toplu_ref"/>
                        </group>
                        <group string="Tarihler">
                            <field name="planlanan_baslangic" readonly="state != 'taslak'"/>
                            <field name="planlanan_bitis" readonly="state != 'taslak'"/>
                            <field name="istenen_bitis" invisible="state not in ('onaylandi', 'teslim_edildi')" readonly="not talep_sahibi_mi"/>
                            <field name="fiili_baslangic" invisible="state in ('taslak', 'talep_edildi', 'onaylandi')" readonly="1"/>
                            <field name="fiili_bitis" invisible="state in ('taslak', 'talep_edildi', 'onaylandi')" readonly="1"/>
                        </group>
                    </group>
                    <group string="Red Gerekçesi" invisible="state not in ('talep_edildi', 'reddedildi')">
                        <field name="red_gerekcesi" readonly="state != 'talep_edildi'"/>
                    </group>
                    <group string="İptal Nedeni" invisible="state not in ('talep_edildi', 'onaylandi', 'iptal')">
                        <field name="iptal_nedeni" readonly="state == 'iptal'"/>
                    </group>
                    <group string="Notlar" invisible="state not in ('teslim_edildi', 'iade_edildi', 'kayip')">
                        <field name="yetkili_mi" invisible="1"/>
                        <field name="kullanici_geri_bildirimi" readonly="state != 'teslim_edildi' or not talep_sahibi_mi"/>
                        <field name="kapanis_notu" readonly="state != 'teslim_edildi' or not yetkili_mi"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ekipman_zimmet_search" model="ir.ui.view">
        <field name="name">ekipman.zimmet.search</field>
        <field name="model">ekipman.zimmet</field>
        <field name="arch" type="xml">
            <search string="Zimmet Ara">
                <field name="name"/>
                <field name="cihaz_id"/>
                <field name="calisan_id"/>
                <filter string="Güncel Talepler" name="guncel_talepler"
                        domain="['|', ('state', 'not in', ('iade_edildi', 'kayip', 'reddedildi', 'iptal')),
                                 ('kapanis_tarihi', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Açık Talepler" name="acik_talepler" domain="[('state', 'not in', ('iade_edildi', 'kayip', 'reddedildi', 'iptal'))]"/>
                <separator/>
                <filter string="Taslak" name="taslak" domain="[('state', '=', 'taslak')]"/>
                <filter string="Talep Edildi" name="talep_edildi" domain="[('state', '=', 'talep_edildi')]"/>
                <filter string="Onay Bekleyenler" name="onay_bekleyenler" domain="[('state', '=', 'talep_edildi')]"/>
                <filter string="Onaylandı" name="onaylandi" domain="[('state', '=', 'onaylandi')]"/>
                <filter string="Teslim Bekleyenler" name="teslim_bekleyenler" domain="[('state', '=', 'onaylandi')]"/>
                <filter string="Teslim Edildi" name="teslim_edildi" domain="[('state', '=', 'teslim_edildi')]"/>
                <filter string="İade Edildi" name="iade_edildi" domain="[('state', '=', 'iade_edildi')]"/>
                <filter string="Kayıp" name="kayip" domain="[('state', '=', 'kayip')]"/>
                <separator/>
                <filter string="Gecikenler" name="gecikenler" domain="[('state', '=', 'teslim_edildi'), ('planlanan_bitis', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Uzatma Bekleyenler" name="uzatma_bekleyenler" domain="[('istenen_bitis', '!=', False)]"/>
                <filter string="Süresi Geçmiş Onaylar" name="suresi_gecmis_onaylar" domain="[('state', '=', 'onaylandi'), ('planlanan_bitis', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Kullanılamayan Cihaz Onayları" name="kullanilamayan_cihaz_onaylari" domain="[('state', '=', 'onaylandi'), ('cihaz_id.kullanilabilirlik', '!=', 'kullanilabilir')]"/>
                <separator/>
                <group expand="0" string="Grupla">
                    <filter string="Cihaz" name="group_cihaz" context="{'group_by': 'cihaz_id'}"/>
                    <filter string="Çalışan" name="group_calisan" context="{'group_by': 'calisan_id'}"/>
                    <filter string="Durum" name="group_durum" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ekipman_zimmet" model="ir.actions.act_window">
        <field name="name">Zimmet Talepleri</field>
        <field name="res_model">ekipman.zimmet</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_guncel_talepler': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Yeni bir zimmet talebi oluşturun.
            </p>
        </field>
    </record>
</odoo>
